{% macro show(rows, columns, csrf = '') %}
<div class="table-responsive"><table class="table table-vcenter card-table">
<thead><tr>{% for label in columns %}<th scope="col">{{ label }}</th>{% endfor %}</tr></thead>
<tbody>{% for row in rows %}<tr>{% for key, label in columns %}<td>{% if key == 'restore_key' %}{% if row.object_type == 'domain' and row.domain_state == 'deleted' and not row.job_id %}<form method="post" action="/lifecycle"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="key" value="{{ row.restore_key }}"><input type="hidden" name="command" value="domain.restore"><input type="hidden" name="registry_id" value="{{ row.registry_id }}"><input type="hidden" name="domainname" value="{{ row.object_name }}"><button class="btn btn-sm btn-outline-primary">Restore at configured price</button></form>{% else %}—{% endif %}{% elseif key == 'account_id' %}<a class="fw-semibold" href="/admin/resellers/{{ row[key] }}">{{ row.username }}</a><div class="uuid text-secondary small">{{ row[key] }}</div>{% elseif row.account_id is defined and key == 'role' %}{{ row.role == 0 ? 'Administrator' : 'Reseller' }}{% elseif row.account_id is defined and key == 'status' %}<span class="badge {{ row.status == 'active' ? 'bg-green-lt' : 'bg-secondary-lt' }}">{{ row.status }}</span>{% elseif key == 'tld_actions' %}
<form method="post" action="/admin/tlds" class="mb-2"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="action" value="tld.save"><input type="hidden" name="registry_id" value="{{ row.registry_id }}"><input type="hidden" name="tld" value="{{ row.tld }}"><input type="hidden" name="enabled" value="{{ row.enabled ? '0' : '1' }}"><button class="btn btn-sm btn-outline-primary">{{ row.enabled ? 'Disable' : 'Enable' }}</button></form>
<form method="post" action="/admin/tlds"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="action" value="tld.delete"><input type="hidden" name="registry_id" value="{{ row.registry_id }}"><input type="hidden" name="tld" value="{{ row.tld }}"><label class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirmed" value="1" required><span class="form-check-label">Remove TLD, grants and prices</span></label><button class="btn btn-sm btn-outline-danger">Remove unused TLD</button></form>
{% elseif key == 'grant_actions' %}<form method="post" action="/admin/tlds"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="action" value="tld.unassign"><input type="hidden" name="reseller_id" value="{{ row.reseller_id }}"><input type="hidden" name="registry_id" value="{{ row.registry_id }}"><input type="hidden" name="tld" value="{{ row.tld }}"><button class="btn btn-sm btn-outline-danger">Remove assignment</button></form>{% elseif key == 'admin_job_id' %}<a class="uuid" href="/admin/jobs/{{ row[key] }}">{{ row[key] }}</a>{% elseif key == 'check_id' %}<a class="uuid" href="/checks/{{ row[key] }}">{{ row[key] }}</a>{% else %}{{ attribute(row, key) is null ? '—' : attribute(row, key) }}{% endif %}</td>{% endfor %}</tr>
{% else %}<tr><td colspan="{{ columns|length }}" class="text-secondary text-center py-4">No records to display.</td></tr>{% endfor %}</tbody>
</table></div>
{% endmacro %}
