{% extends 'layouts/app.twig' %}
{% import 'partials/forms.twig' as forms %}
{% block content %}
<div class="card card-body"><p><a href="/admin/resellers">Back to resellers</a></p>
<p class="text-secondary">Reseller UUID: <span class="uuid">{{ account.id }}</span>. Status: {{ account.status }}. Role: {{ account.role }}. Wallet currency: {{ account.currency }}.</p>
<h2 class="card-title">Account details</h2>
<form method="post">{{ forms.hidden('user.update', csrf) }}
{% for field, label in {'username':'API / panel username', 'display_name':'Contact name', 'company':'Company', 'email':'Contact email', 'phone':'Phone', 'country_code':'Country code (two letters)'} %}
<label class="form-label mb-3">{{ label }}<input class="form-control" name="{{ field }}" value="{{ attribute(account, field) }}" type="{{ field == 'email' ? 'email' : 'text' }}" maxlength="{{ field == 'username' ? 64 : (field == 'phone' ? 32 : (field == 'country_code' ? 2 : (field == 'email' ? 254 : 255))) }}"{% if field == 'username' %} required minlength="3" pattern="[A-Za-z0-9][A-Za-z0-9._\-]{2,63}"{% endif %}></label>
{% endfor %}
<label class="form-label mb-3">Postal address<textarea class="form-control" name="address" maxlength="2000" rows="4">{{ account.address }}</textarea></label>
<p class="text-secondary">Changing the username revokes API tokens and panel sessions; the existing password still works with the new username. Contact details are optional and do not change login or wallet currency. Manage status, role and credentials below.</p>
<button class="btn btn-primary">Save account</button></form></div>
<div class="row row-cards mt-4">
<div class="col-12 col-lg-4"><div class="card h-100"><div class="card-body"><h2 class="card-title">Account status</h2>
<form method="post">{{ forms.hidden('user.status', csrf) }}
<label class="form-label mb-3">Status<select class="form-select" name="status" required><option value="active"{% if account.status == 'active' %} selected{% endif %}>Active</option><option value="suspended"{% if account.status == 'suspended' %} selected{% endif %}>Suspended</option></select></label>
<p class="text-secondary">Suspending this reseller revokes its API tokens and panel sessions. You cannot suspend your own account.</p>
<button class="btn btn-primary">Save status</button></form></div></div></div>
<div class="col-12 col-lg-4"><div class="card h-100"><div class="card-body"><h2 class="card-title">Role</h2>
<form method="post">{{ forms.hidden('user.role', csrf) }}
<label class="form-label mb-3">Role<select class="form-select" name="role" required><option value="1"{% if account.role == 1 %} selected{% endif %}>Reseller</option><option value="0"{% if account.role == 0 %} selected{% endif %}>Administrator — full control</option></select></label>
<p class="text-secondary">Administrator access grants full control of the panel. You cannot remove your own administrator role.</p>
<button class="btn btn-primary">Save role</button></form></div></div></div>
<div class="col-12 col-lg-4"><div class="card h-100"><div class="card-body"><h2 class="card-title">Reset API and panel password</h2>
<form method="post">{{ forms.hidden('user.password', csrf) }}{{ forms.input('password', 'New password', 'password') }}{{ forms.input('password_confirm', 'Confirm password', 'password') }}
<p class="text-secondary">Resets login lockout and revokes this reseller's API tokens and panel sessions.</p><button class="btn btn-primary">Reset password</button></form>
<hr><form method="post">{{ forms.hidden('tokens.revoke', csrf) }}<button class="btn btn-outline-danger">Revoke tokens and sessions</button></form>
</div></div></div>
</div>
{% endblock %}
