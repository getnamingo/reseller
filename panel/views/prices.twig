{% extends 'layouts/app.twig' %}
{% macro amount(price) %}
<td class="text-end text-nowrap" data-price-value="{{ price ? price.amount ~ ' ' ~ price.currency : '' }}">{% if price %}<span class="fw-semibold">{{ price.amount }} <span class="text-secondary">{{ price.currency }}</span></span>{% if price.scope == 'Reseller override' %}<div class="small text-primary">Your override</div>{% endif %}{% else %}<span class="text-secondary">—</span>{% endif %}</td>
{% endmacro %}
{% block content %}
<p class="text-secondary">Yearly prices for your permitted TLDs. Registration includes DNSSEC at the same price. Transfer query, cancel, approve and reject are always free.</p>
<div class="card" id="customer-prices">
<div id="customer-prices-tools" hidden><div class="card-header"><div class="row g-2 align-items-center w-100">
<div class="col-12 col-sm-6 col-md-4"><label class="visually-hidden" for="price-tld-search">Search by TLD</label><input class="form-control" id="price-tld-search" type="search" placeholder="Search by TLD…" autocomplete="off"></div>
<div class="col-auto ms-auto"><button class="btn" type="button" id="price-export" title="Export matching rows as CSV"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 16v4h16v-4M12 3v12m-4-4 4 4 4-4"/></svg>Export CSV</button></div>
</div></div></div>
<div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th scope="col">TLD</th><th scope="col">Period</th><th scope="col" class="text-end">Registration</th><th scope="col" class="text-end">Renewal</th><th scope="col" class="text-end">Incoming transfer</th><th scope="col" class="text-end">Restore</th></tr></thead><tbody>
{% for group in price_groups %}
{% set yearly = group.terms[1] ?? {} %}
<tr data-price-row data-price-tld="{{ group.tld }}" data-price-registry="{{ group.registry }}">
<th scope="row"><span class="fw-semibold">{{ group.tld ? '.' ~ group.tld : 'Registry-wide defaults' }}</span><div class="small text-secondary fw-normal">{{ group.registry }}</div></th>
<td class="text-nowrap">{% if group.tld %}<span class="badge bg-blue-lt">Yearly</span>{% else %}<span class="text-secondary">Per operation</span>{% endif %}</td>
{{ _self.amount(yearly['domain.create'] ?? null) }}{{ _self.amount(yearly['domain.renew'] ?? null) }}{{ _self.amount(yearly['domain.transfer'] ?? null) }}{{ _self.amount(group.restore ?? null) }}
</tr>
{% else %}<tr><td colspan="6" class="text-secondary text-center py-4">No prices are configured for your permitted TLDs.</td></tr>{% endfor %}
<tr id="price-no-matches" hidden><td colspan="6" class="text-secondary text-center py-4">No TLDs match your search.</td></tr>
</tbody></table></div>
<div class="card-footer text-secondary small" id="price-result-count" role="status" aria-live="polite">{{ price_groups|length }} price rows</div>
</div>
<p class="text-secondary mt-3">Registration, renewal and incoming transfer show exact one-year totals; restore is per operation. A dash means no exact price row is listed; a parent-suffix or registry-wide fallback may still apply. The longest matching suffix takes priority, then your reseller override. This is a configured price list, not a live premium-domain quote. Export CSV downloads the rows matching your search.</p>
<script src="/prices.js" defer></script>
{% endblock %}
