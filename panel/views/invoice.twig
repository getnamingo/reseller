{% extends 'layouts/app.twig' %}
{% block page_actions %}{% if record.status == 'issued' %}<a class="btn" href="{{ path }}/{{ record.id }}/pdf" target="_blank" rel="noopener">Open PDF</a><a class="btn btn-primary" href="{{ path }}/{{ record.id }}/pdf?download=1">Download PDF</a>{% endif %}{% endblock %}
{% block content %}
<p><a href="{{ path }}">Back to invoices</a></p>
<div class="card"><div class="card-body p-4 p-md-5"><div class="row mb-4"><div class="col"><div class="text-blue fw-bold small">{{ invoice.seller.name }}</div><h2 class="display-6 fw-bold">INVOICE</h2><span class="text-secondary">{{ invoice.number }}</span></div><div class="col-auto text-end"><div>Issued {{ invoice.issued_at }}</div><div class="text-secondary">{{ invoice.period_start }} – {{ invoice.period_end }}</div><span class="badge bg-green-lt mt-2">Paid from wallet</span></div></div>
<hr class="border-primary"><div class="row g-4 my-3"><div class="col-md-6"><h3 class="text-blue">From</h3><div class="fw-semibold">{{ invoice.seller.name }}</div><div class="text-break">{{ invoice.seller.address|nl2br }}</div><div>{{ invoice.seller.postcode }} {{ invoice.seller.city }}</div><div>{{ invoice.seller.country }}</div><div>Company no. {{ invoice.seller.company_number }}</div>{% if invoice.seller.vat_number %}<div>VAT {{ invoice.seller.vat_number }}</div>{% endif %}<div>{{ invoice.seller.email }}</div></div><div class="col-md-6"><h3 class="text-blue">Bill to</h3><div class="fw-semibold">{{ invoice.customer.company }}</div><div class="text-break">{{ invoice.customer.address|nl2br }}</div><div>{{ invoice.customer.billing_postcode }} {{ invoice.customer.billing_city }}</div><div>{{ invoice.customer.country_code }}</div><div>Company no. {{ invoice.customer.company_number }}</div>{% if invoice.customer.vat_number %}<div>VAT {{ invoice.customer.vat_number }}</div>{% endif %}<div>{{ invoice.customer.billing_email }}</div></div></div>
<div class="table-responsive"><table class="table table-vcenter"><thead><tr><th>Supply date</th><th>Service</th><th>Qty</th><th class="text-end">Unit net</th><th class="text-end">Net</th></tr></thead><tbody>{% for line in invoice.lines %}<tr><td>{{ line.date }}</td><td class="text-break">{{ line.description }}</td><td>{{ line.quantity }}</td><td class="text-end">{{ line.unit_net }}</td><td class="text-end">{{ line.net }}</td></tr>{% else %}<tr><td colspan="5" class="text-secondary">No billable service activity.</td></tr>{% endfor %}</tbody></table></div>
<div class="row justify-content-end mt-4"><div class="col-md-6 col-lg-4"><div class="d-flex justify-content-between mb-2"><span>Subtotal</span><span>{{ invoice.net }} {{ invoice.currency }}</span></div><div class="d-flex justify-content-between mb-3"><span>VAT {{ invoice.vat_rate }}%</span><span>{{ invoice.vat }} {{ invoice.currency }}</span></div><div class="d-flex justify-content-between text-blue fs-2 fw-bold border-top pt-3"><span>Total</span><span>{{ invoice.total }} {{ invoice.currency }}</span></div></div></div>
<p class="text-success mt-4">{{ invoice.payment_note }}</p>{% if invoice.tax_note %}<p class="text-secondary">{{ invoice.tax_note }}</p>{% endif %}{% if invoice.tax_currency != invoice.currency and invoice.vat != '0.0000' %}<p class="text-secondary">VAT in tax currency: {{ invoice.tax_currency_vat }} {{ invoice.tax_currency }} (1 {{ invoice.currency }} = {{ invoice.tax_fx_rate }} {{ invoice.tax_currency }}).</p>{% endif %}
</div></div>
{% if section %}<div class="card card-body mt-4"><h3>Email delivery</h3><p>Status: {{ record.email_status }} · Attempts: {{ record.email_attempts }}{% if record.emailed_at %} · Sent {{ record.emailed_at }}{% endif %}</p>{% if record.status == 'issued' and record.email_status != 'sent' %}<form method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="action" value="retry-email"><label class="form-check mb-3"><input class="form-check-input" name="confirmed" value="1" type="checkbox" required><span class="form-check-label">I checked delivery with the recipient or mail server. Sending again may create a duplicate email.</span></label><button class="btn btn-primary">Send invoice email</button></form>{% endif %}</div>{% endif %}
{% endblock %}
