{% extends 'layouts/app.twig' %}
{% import 'partials/table.twig' as tables %}
{% block content %}
{% if batch %}
<div class="card mb-4"><div class="card-header"><h2 class="card-title">Availability results</h2></div>
<div class="table-responsive"><table class="table"><thead><tr><th>Domain</th><th>Registry</th><th>Result</th><th>Reason</th></tr></thead><tbody>
{% for row in results %}<tr><td>{{ row.name }}</td><td>{% if row.job_uuid %}<a href="/checks/{{ row.job_uuid }}">{{ row.registry }}</a>{% else %}{{ row.registry ?? '—' }}{% endif %}</td><td>{{ row.status }}</td><td>{{ row.reason }}</td></tr>{% endfor %}
</tbody></table></div>
<div class="card-footer"><a class="btn btn-primary" href="/checks?batch={{ batch }}">Refresh results</a> <span class="text-secondary">Refreshing only reads existing checks. Batch results remain in this session for the latest 10 submissions.</span></div></div>
{% endif %}
<div class="row row-cards">
<div class="col-lg-6"><div class="card card-body">
  <h2 class="card-title">Check domain availability</h2>
  <form method="post" action="/checks"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="key" value="{{ key }}">
    <label class="form-label mb-3">Domain names<textarea class="form-control" name="domains" rows="6" maxlength="15000" placeholder="example.com&#10;example.net" required></textarea></label>
    <p class="text-secondary">One domain per line, up to 50. Use ASCII / punycode names without a trailing dot. Registries are chosen automatically from the longest permitted TLD match. Availability checks are free.</p>
    <button class="btn btn-primary">Check availability</button>
  </form>
</div></div>
<div class="col-lg-6"><div class="card"><div class="card-header"><h2 class="card-title">Permitted TLDs</h2></div>
  <ul class="list-group list-group-flush">{% for item in access %}{% if item.registry_enabled and item.access_enabled and item.tld_enabled and item.permitted %}<li class="list-group-item"><strong>.{{ item.tld }}</strong> <span class="text-secondary">{{ item.registry }}</span></li>{% endif %}{% endfor %}</ul>
  <div class="card-footer text-secondary">Only explicitly permitted TLDs are accepted.</div>
</div></div>
</div>
<div class="card mt-4"><div class="card-header"><h2 class="card-title">Latest 50 availability checks</h2></div>
{{ tables.show(jobs, {'check_id':'Check UUID', 'status':'Status', 'price':'Price', 'currency':'Currency', 'created_at':'Date'}) }}
</div>
{% endblock %}
