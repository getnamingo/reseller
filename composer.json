{
    "name": "namingo/reseller",
    "description": "Compact Swoole JSON API and ledger facade for Namingo EPP Client",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-simplexml": "*",
        "ext-sodium": "*",
        "ext-swoole": "*",
        "ext-xmlwriter": "*",
        "guzzlehttp/guzzle": "^7.9",
        "pinga/tembo": "1.1.23",
        "vlucas/phpdotenv": "^5.6",
        "slim/slim": "4.15.3",
        "slim/twig-view": "^3.4.1",
        "nyholm/psr7": "^1.8.2",
        "nyholm/psr7-server": "^1.1.0",
        "argora/tabler-assets": "^1.4"
    },
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-install-cmd": [
            "@panel-assets"
        ],
        "post-update-cmd": [
            "@panel-assets"
        ],
        "panel-assets": "@php bin/panel-assets.php"
    }
}
