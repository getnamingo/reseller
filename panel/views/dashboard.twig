{% extends 'layouts/app.twig' %}
{% import 'partials/table.twig' as tables %}
{% block content %}
<div class="row row-cards mb-4">
  <div class="col-md-6"><div class="card card-body"><div class="subheader">Available balance</div><div class="h1">{{ user.available_balance }} {{ user.currency }}</div><a href="/wallet">View ledger</a></div></div>
  <div class="col-md-6"><div class="card card-body"><div class="subheader">Held balance</div><div class="h1">{{ user.held_balance }} {{ user.currency }}</div><p class="mb-0 text-secondary">Reserved for pending or uncertain operations.</p></div></div>
</div>
<div class="card mb-4"><div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
  <div><h2 class="card-title">Find your next domain</h2><p class="text-secondary mb-0">Check availability across your permitted registries and TLDs.</p></div>
  <a class="btn btn-primary" href="/checks">Check availability</a>
</div></div>
<div class="row row-cards mb-4">{% for item in counts %}<div class="col-sm-4"><div class="card card-body"><div class="subheader">{{ item.object_type|capitalize }} objects</div><div class="h2 mb-0">{{ item.total }}</div></div></div>{% endfor %}</div>
<div class="card"><div class="card-header"><h2 class="card-title">Latest API jobs</h2><a class="ms-auto" href="/jobs">Full history</a></div>
{{ tables.show(jobs, {'id':'Job UUID', 'command':'Command', 'status':'Status', 'price':'Price', 'currency':'Currency', 'created_at':'Date'}) }}
</div>
{% endblock %}
