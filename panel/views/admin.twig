{% extends 'layouts/app.twig' %}
{% import 'partials/table.twig' as tables %}
{% import 'partials/forms.twig' as forms %}
{% block page_actions %}{% if section == 'prices' %}<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#add-price">Add price</button>{% elseif section == 'resellers' %}<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#add-reseller">Add a reseller</button>{% elseif section == 'registries' %}<div class="btn-list"><button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#add-registry">Add a registry</button><button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#add-tld">Add TLD</button></div>{% endif %}{% endblock %}
{% block content %}
<datalist id="resellers">{% for item in resellers %}<option value="{{ item.id }}">{{ item.username }}</option>{% endfor %}</datalist>
<datalist id="registries">{% for item in registries %}<option value="{{ item.id }}">{{ item.name }}</option>{% endfor %}</datalist>
{% if section not in ['prices', 'deposits', 'jobs'] %}
<div class="{{ section in ['prices', 'resellers', 'registries'] ? 'mb-4' : 'action-grid mb-4' }}">
{% if section == 'resellers' %}
<p class="text-secondary">Select a reseller to manage account details, status, role and credentials.</p>
{% elseif section == 'registries' %}
<p class="text-secondary">Choose a registry to edit its settings, manage TLDs or configure TLD permissions.</p>
{% elseif section == 'ownership' %}
<div class="card card-body"><h2 class="card-title">Import verified existing ownership</h2><form method="post">{{ forms.hidden('object.assign', csrf) }}
  {{ forms.input('registry_id', 'Registry UUID', 'text', '', 'registries') }}{{ forms.input('reseller_id', 'Reseller UUID', 'text', '', 'resellers') }}
  {{ forms.select('object_type', 'Type', {'domain':'Domain', 'contact':'Contact', 'host':'Host / NSSET'}) }}{{ forms.input('object_name', 'ASCII name or identifier') }}
  {{ forms.select('domain_state', 'Verified domain state (use Active for contacts/hosts)', {'active':'Active', 'deleted':'Deleted but still in redemption'}) }}
  <p class="text-secondary">Only import independently verified existing objects. This never changes registry ownership or replaces an existing mapping.</p><button class="btn btn-primary">Import ownership</button>
</form></div>
{% endif %}
</div>
{% endif %}
{% if section == 'prices' %}{% include 'partials/price_list.twig' %}{% elseif section == 'registries' %}{% include 'partials/registry_list.twig' %}{% elseif section in ['deposits', 'jobs'] %}{% include 'partials/admin_transactions.twig' %}{% else %}<div class="card">{{ tables.show(rows, columns, csrf) }}</div>{% endif %}
{% include 'partials/pagination.twig' %}
{% if section == 'resellers' %}
<div class="modal modal-blur fade" id="add-reseller" tabindex="-1" aria-labelledby="add-reseller-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form method="post" class="modal-content">{{ forms.hidden('user.create', csrf) }}
<div class="modal-header"><h2 class="modal-title" id="add-reseller-title">Add a reseller</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
<div class="modal-body">{{ forms.input('username', 'Username') }}{{ forms.input('currency', 'Currency', 'text', 'EUR') }}{{ forms.input('password', 'Password', 'password') }}{{ forms.input('password_confirm', 'Confirm password', 'password') }}
<p class="text-secondary mb-0">New accounts have reseller role 1. Their API and panel credentials are shared.</p></div>
<div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Create reseller</button></div>
</form></div></div>
{% endif %}
{% if section == 'registries' %}
<div class="modal modal-blur fade" id="add-registry" tabindex="-1" aria-labelledby="add-registry-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable"><form method="post" class="modal-content">{{ forms.hidden('registry.save', csrf) }}
<div class="modal-header"><h2 class="modal-title" id="add-registry-title">Add a registry</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
<div class="modal-body">{{ forms.input('name', 'Display name') }}<label class="form-label mb-3">EPP profile<select class="form-select" name="profile">{% for profile in profiles %}<option>{{ profile }}</option>{% endfor %}</select></label>
{% include 'partials/registry_fields.twig' %}<p class="text-secondary">Registry configuration is stored encrypted.</p></div>
<div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Create registry</button></div></form></div></div>
{% include 'partials/add_tld_modal.twig' %}
{% endif %}
{% if section == 'prices' %}
<div class="modal modal-blur fade" id="add-price" tabindex="-1" aria-labelledby="add-price-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl"><div class="modal-content">
<div class="modal-header"><h2 class="modal-title" id="add-price-title">Add price — TLD price table</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
<div class="modal-body">{% include 'partials/price_form.twig' %}</div></div></div></div>
{% elseif section in ['deposits', 'jobs'] %}{% include 'partials/admin_confirmation.twig' %}{% endif %}
{% endblock %}
