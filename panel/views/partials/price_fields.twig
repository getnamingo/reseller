<div class="table-responsive" data-price-term-fields><table class="table table-vcenter"><thead><tr><th>Years</th>{% for command, label in price_operations %}{% if command != 'domain.restore' %}<th>{{ label }}</th>{% endif %}{% endfor %}</tr></thead><tbody>
{% for year in 1..10 %}<tr><th scope="row">{{ year }}</th>{% for command, label in price_operations %}{% if command != 'domain.restore' %}<td><input class="form-control price-amount" type="number" min="0" step="0.0001" name="amounts[{{ command }}][{{ year }}]" aria-label="{{ label }}, {{ year }} years" data-price-amount data-price-command="{{ command }}" data-price-period="{{ year }}" required></td>{% endif %}{% endfor %}</tr>{% endfor %}
</tbody></table></div>
<div class="mt-3"><label class="form-label mb-3">Restore — per operation<input class="form-control" type="number" min="0" step="0.0001" name="amounts[domain.restore][0]" data-price-amount data-price-command="domain.restore" data-price-period="0" required></label></div>
