APP_ENV=production
APP_MASTER_KEY=base64:REPLACE_WITH_php_bin_manage_php_key_generate

API_HOST=127.0.0.1
# Empty for direct access. Exact proxy IPs only; proxies must overwrite X-Forwarded-For.
API_TRUSTED_PROXIES=
API_PORT=9501
API_TLS_CERT=
API_TLS_KEY=
API_ALLOW_INSECURE_HTTP=false
API_WORKERS=4
API_TASK_WORKERS=4
API_SYNC_WAIT_SECONDS=25
API_EPP_LOCK_SECONDS=35
API_RATE_LIMIT_PER_MINUTE=120
API_LOGIN_LIMIT_PER_MINUTE=10
API_MAX_BODY_BYTES=262144
TOKEN_TTL_SECONDS=43200
AUTH_MAX_FAILURES=5
AUTH_LOCK_SECONDS=900
RUNTIME_DIR=/run/namingo-epp-api

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=namingo_api
DB_USER=namingo_api
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DB_SOCKET=
DB_TLS_CA=

# Foundry reseller panel (PHP-FPM; web root is panel/public)
PANEL_ORIGIN=https://panel.example.com
PANEL_API_URL=http://127.0.0.1:9501
PANEL_API_CA=
PANEL_SESSION_DIR=/var/lib/namingo-api/panel-sessions
PANEL_IDLE_SECONDS=1800

# Durable job dispatch and read-only lifecycle monitoring (API worker 0)
API_QUEUE_TICK_MS=1000
API_QUEUE_BATCH=8
API_QUEUE_MAX_INFLIGHT=8
API_DISPATCH_LEASE_SECONDS=60
API_JOB_STALE_SECONDS=900
API_RECONCILE_SECONDS=30
API_PURGE_CHECK_SECONDS=300
API_TRANSFER_CHECK_SECONDS=900

# Monthly invoices: configure issuer, reseller billing/VAT profiles and SMTP before enabling.
INVOICING_ENABLED=0
DATA_DIRECTORY=/var/lib/namingo-api/data
INVOICE_NUMBER_PREFIX=INV
INVOICE_SELLER_NAME=
INVOICE_SELLER_COMPANY_NUMBER=
INVOICE_SELLER_VAT_NUMBER=
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_CITY=
INVOICE_SELLER_POSTCODE=
INVOICE_SELLER_COUNTRY=
INVOICE_SELLER_EMAIL=
INVOICE_SELLER_TAX_CURRENCY=EUR
# VAT reporting conversion: month -> invoice currency -> tax currency units per 1 invoice unit.
INVOICE_TAX_FX_RATES='{}'
INVOICE_FONT_REGULAR=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
INVOICE_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=tls
SMTP_USERNAME=
SMTP_PASSWORD=
