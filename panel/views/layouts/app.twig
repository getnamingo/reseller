{# Adapted from Argora Foundry's Tabler page shell; copyright 2025 Argora (MIT). #}
<!doctype html>
<html lang="en" data-bs-theme-primary="blue">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ title }} | Namingo Reseller</title>
  <link href="/assets/css/tabler.min.css" rel="stylesheet">
  <link href="/panel.css" rel="stylesheet">
</head>
<body{% if not user %} class="border-top-wide border-primary d-flex flex-column"{% endif %}>
<div class="page">
{% if user %}
<header class="navbar navbar-expand-md navbar-light d-print-none">
  <div class="container-xl">
    <a class="navbar-brand" href="/">Namingo <span class="text-secondary ms-1">Reseller</span></a>
    <div class="navbar-nav flex-row ms-auto align-items-center gap-3">
      <a class="nav-link" href="/account"><span class="avatar avatar-sm bg-primary-lt me-2">{{ user.username|slice(0, 2)|upper }}</span><span class="text-truncate account-name">{{ user.username }}</span></a>
      <form method="post" action="/logout"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn btn-outline-secondary btn-sm">Sign out</button></form>
    </div>
  </div>
</header>
<nav class="navbar navbar-light" aria-label="Main navigation"><div class="container-xl"><div class="nav nav-pills gap-1 flex-wrap">
  <a class="nav-link" href="/">Dashboard</a><a class="nav-link" href="/checks">Availability</a>
  <a class="nav-link" href="/prices">Prices</a>
  <a class="nav-link" href="/wallet">Wallet</a><a class="nav-link" href="/jobs">Jobs</a><a class="nav-link" href="/domains">Domains</a><a class="nav-link" href="/contacts">Contacts</a><a class="nav-link" href="/account">Account</a>
</div></div></nav>
{% if user.role == 0 %}
<nav class="navbar navbar-light border-top" aria-label="Administration"><div class="container-xl"><div class="nav nav-pills gap-1 flex-wrap">
  <span class="nav-link text-primary fw-bold">Administration</span>
  {% for section in ['resellers', 'registries', 'domains', 'contacts', 'prices', 'deposits', 'jobs', 'ownership'] %}
    <a class="nav-link" href="/admin/{{ section }}">{{ section|capitalize }}</a>
  {% endfor %}
</div></div></nav>
{% endif %}
{% endif %}
<main class="page-wrapper">
  <div class="page-body"><div class="{{ user ? 'container-xl' : 'container-tight py-5' }}">
    {% if flash %}<div class="alert alert-success" role="status">{{ flash }}</div>{% endif %}
    {% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
    {% if user %}<div class="page-header mb-4"><div class="row align-items-center g-2"><div class="col"><div class="page-pretitle">{{ section ? 'Administration' : 'Reseller workspace' }}</div><h1 class="page-title">{{ title }}</h1></div><div class="col-auto ms-auto d-print-none">{% block page_actions %}{% endblock %}</div></div></div>{% endif %}
    {% block content %}{% endblock %}
  </div></div>
  <footer class="footer footer-transparent"><div class="container-xl text-center text-secondary">Namingo Reseller · Built on Argora Foundry</div></footer>
</main>
</div>
{% include 'partials/js.twig' %}
</body>
</html>
