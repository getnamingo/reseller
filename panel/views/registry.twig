{% extends 'layouts/app.twig' %}
{% import 'partials/forms.twig' as forms %}
{% block page_actions %}{% if view == 'tlds' %}<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#add-tld">Add TLD</button>{% elseif view == 'permissions' %}<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#permit-tld">Permit a TLD</button>{% endif %}{% endblock %}
{% block content %}
<p><a href="/admin/registries">Back to registries</a></p>
<div class="btn-list mb-4"><a class="btn {{ view == 'edit' ? 'btn-primary' : 'btn-outline-primary' }}" href="/admin/registries/{{ registry.id }}">Edit registry</a><a class="btn {{ view == 'tlds' ? 'btn-primary' : 'btn-outline-primary' }}" href="/admin/registries/{{ registry.id }}/tlds">TLDs</a><a class="btn {{ view == 'permissions' ? 'btn-primary' : 'btn-outline-primary' }}" href="/admin/registries/{{ registry.id }}/permissions">TLD permissions</a></div>
<p class="text-secondary">Registry UUID: <span class="uuid">{{ registry.id }}</span></p>
<datalist id="resellers">{% for reseller in resellers %}<option value="{{ reseller.id }}">{{ reseller.username }}</option>{% endfor %}</datalist>
{% if view == 'edit' %}
<div class="card card-body mb-4"><h2 class="card-title">Update registry</h2><form method="post" id="update-registry-form">{{ forms.hidden('registry.save', csrf) }}{{ forms.input('name', 'Display name', 'text', registry.name) }}
<label class="form-label mb-3">EPP profile<select class="form-select" name="profile">{% for profile in profiles %}<option{% if profile == registry.profile %} selected{% endif %}>{{ profile }}</option>{% endfor %}</select></label>
{% include 'partials/registry_fields.twig' with {registry_ssl_generator: true} %}
<p class="text-secondary">Stored configuration is loaded into these administrator-only fields and saved encrypted.</p><button class="btn btn-primary" type="submit">Save registry</button></form></div>
<div class="row row-cards mb-4"><div class="col-md-6"><div class="card card-body h-100"><h2 class="card-title">Registry state</h2><form method="post">{{ forms.hidden('registry.status', csrf) }}<input type="hidden" name="enabled" value="{{ registry.enabled ? '0' : '1' }}"><button class="btn {{ registry.enabled ? 'btn-success' : 'btn-secondary' }}">{{ registry.enabled ? 'Enabled — disable' : 'Disabled — enable' }}</button></form></div></div>
<div class="col-md-6"><div class="card card-body h-100"><h2 class="card-title">Reseller access</h2><form method="post">{{ forms.hidden('registry.access', csrf) }}{{ forms.input('reseller_id', 'Reseller UUID', 'text', '', 'resellers') }}{{ forms.enabled() }}<button class="btn btn-primary">Save access</button></form></div></div></div>
{% elseif view == 'tlds' %}<p class="text-secondary">Toggle a suffix to enable or disable it. Removing an unused TLD deletes its assignments and exact prices; owned domains and unsettled jobs block removal.</p>
{% endif %}
<div class="card"><div class="card-header"><h2 class="card-title">{{ view == 'edit' ? 'Registry permissions' : (view == 'tlds' ? 'Configured TLDs' : 'TLD permissions') }}</h2></div><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr>{% if view != 'tlds' %}<th>Reseller</th>{% endif %}{% if view != 'edit' %}<th>TLD</th>{% endif %}<th>State</th><th>Actions</th></tr></thead><tbody>
{% for row in rows %}<tr>{% if view != 'tlds' %}<td>{{ row.username }}<div class="uuid text-secondary small">{{ row.reseller_id }}</div></td>{% endif %}{% if view != 'edit' %}<td>.{{ row.tld }}</td>{% endif %}<td><span class="badge {{ row.enabled ? 'bg-green-lt' : 'bg-secondary-lt' }}">{{ row.enabled ? 'Enabled' : 'Disabled' }}</span></td><td>
<form method="post" class="mb-2">{{ forms.hidden(view == 'edit' ? 'registry.access' : (view == 'tlds' ? 'tld.save' : 'tld.access'), csrf) }}
{% if view != 'tlds' %}<input type="hidden" name="reseller_id" value="{{ row.reseller_id }}">{% endif %}{% if view != 'edit' %}<input type="hidden" name="tld" value="{{ row.tld }}">{% endif %}<input type="hidden" name="enabled" value="{{ row.enabled ? '0' : '1' }}"><button class="btn btn-sm {{ row.enabled ? 'btn-success' : 'btn-secondary' }}">{{ row.enabled ? 'Enabled — disable' : 'Disabled — enable' }}</button></form>
{% if view == 'tlds' %}<form method="post">{{ forms.hidden('tld.delete', csrf) }}<input type="hidden" name="tld" value="{{ row.tld }}">{{ forms.confirmed('Remove unused TLD, grants and prices') }}<button class="btn btn-sm btn-outline-danger">Remove unused TLD</button></form>
{% elseif view == 'permissions' %}<form method="post">{{ forms.hidden('tld.unassign', csrf) }}<input type="hidden" name="reseller_id" value="{{ row.reseller_id }}"><input type="hidden" name="tld" value="{{ row.tld }}"><button class="btn btn-sm btn-outline-danger">Remove assignment</button></form>{% endif %}
</td></tr>{% else %}<tr><td colspan="4" class="text-secondary text-center py-4">No records to display.</td></tr>{% endfor %}</tbody></table></div></div>
{% include 'partials/pagination.twig' %}
{% if view == 'tlds' %}{% include 'partials/add_tld_modal.twig' %}{% elseif view == 'permissions' %}
<div class="modal modal-blur fade" id="permit-tld" tabindex="-1" aria-labelledby="permit-tld-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form method="post" class="modal-content">{{ forms.hidden('tld.access', csrf) }}
<div class="modal-header"><h2 class="modal-title" id="permit-tld-title">Permit a TLD — {{ registry.name }}</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><label class="form-label mb-3">Reseller with registry access<select class="form-select" name="reseller_id" required{% if not resellers %} disabled{% endif %}><option value="">Choose a reseller</option>{% for reseller in resellers %}<option value="{{ reseller.id }}">{{ reseller.username }}{% if not reseller.enabled %} — registry access disabled{% endif %}</option>{% endfor %}</select></label>{% if not resellers %}<div class="alert alert-info">Grant registry access to a reseller before permitting a TLD. <a href="/admin/registries/{{ registry.id }}">Manage reseller access</a></div>{% endif %}{% if not tlds %}<div class="alert alert-info">Add a TLD to this registry before assigning permissions. <a href="/admin/registries/{{ registry.id }}/tlds">Manage TLDs</a></div>{% endif %}<label class="form-label mb-3">TLD<select class="form-select" name="tld" required><option value="">Choose a TLD</option>{% for tld in tlds %}<option>{{ tld.tld }}</option>{% endfor %}</select></label>{{ forms.enabled() }}<p class="text-secondary">Only resellers already assigned to this registry are listed. <a href="/admin/registries/{{ registry.id }}">Manage reseller access</a>. Both registry and TLD permissions must be enabled; disabled registry access is never re-enabled by this form.</p></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary"{% if not resellers or not tlds %} disabled{% endif %}>Save permission</button></div>
</form></div></div>{% endif %}
{% if view == 'edit' %}<script src="/registry-ssl.js" defer></script>{% endif %}
{% endblock %}
