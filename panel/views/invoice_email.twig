<!doctype html><html><body style="margin:0;background:#f1f5f9;font-family:Arial,sans-serif;color:#183153"><table role="presentation" style="width:100%;padding:32px 12px"><tr><td align="center"><table role="presentation" style="width:100%;max-width:620px;background:#fff;border-collapse:collapse"><tr><td style="background:#183153;color:#fff;padding:30px;border-bottom:5px solid #206bc4"><div style="font-size:12px;letter-spacing:2px">{{ invoice.seller.name }}</div><h1 style="margin:12px 0 0;font-size:30px">Your monthly invoice</h1></td></tr><tr><td style="padding:30px"><p>Hello {{ invoice.customer.company }},</p><p>Your invoice for {{ invoice.period_start }} to {{ invoice.period_end }} is attached as a PDF.</p><table role="presentation" style="width:100%;background:#f2f6fb;padding:20px"><tr><td>Invoice</td><td align="right"><strong>{{ invoice.number }}</strong></td></tr><tr><td>Issued</td><td align="right">{{ invoice.issued_at }}</td></tr><tr><td style="padding-top:16px">Total</td><td align="right" style="padding-top:16px;color:#206bc4;font-size:24px"><strong>{{ invoice.total }} {{ invoice.currency }}</strong></td></tr></table><p style="color:#25805a">{{ invoice.payment_note }}</p><p>You can also view and download this invoice from the Invoices page in your reseller panel.</p><p style="color:#62748b;font-size:13px">Questions? Contact {{ invoice.seller.email }}.</p></td></tr></table></td></tr></table></body></html>
