{% macro hidden(action, csrf) %}<input type="hidden" name="action" value="{{ action }}"><input type="hidden" name="csrf" value="{{ csrf }}">{% endmacro %}
{% macro input(name, label, type = 'text', value = '', list = '', required = true) %}
<label class="form-label mb-3">{{ label }}<input class="form-control" name="{{ name }}" type="{{ type }}" value="{{ value }}"{% if list %} list="{{ list }}"{% endif %}{% if required %} required{% endif %}{% if type == 'password' %} autocomplete="new-password" minlength="14" maxlength="1024"{% endif %}></label>
{% endmacro %}
{% macro select(name, label, options) %}<label class="form-label mb-3">{{ label }}<select class="form-select" name="{{ name }}" required>{% for value, text in options %}<option value="{{ value }}">{{ text }}</option>{% endfor %}</select></label>{% endmacro %}
{% macro enabled() %}<label class="form-label mb-3">State<select class="form-select" name="enabled"><option value="1">Enabled / permitted</option><option value="0">Disabled / revoked</option></select></label>{% endmacro %}
{% macro confirmed(text) %}<label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="confirmed" value="1" required><span class="form-check-label">{{ text }}</span></label>{% endmacro %}
