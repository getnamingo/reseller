{% extends 'layouts/app.twig' %}
{% block page_actions %}<button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#add-contact">Add contact</button>{% endblock %}
{% block content %}
<div class="card"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Contact</th>{% if section %}<th>Reseller</th>{% endif %}<th>Registries / contact IDs</th><th>Actions</th></tr></thead><tbody>
{% for row in rows %}<tr><td><a class="fw-semibold" href="{{ path }}/{{ row.id }}">{{ row.data.fields.firstname|default('') }} {{ row.data.fields.lastname|default('') }}</a><div>{{ row.data.fields.companyname|default('') }}</div><div class="text-secondary">{{ row.data.fields.email|default('') }}</div><a class="uuid small" href="{{ path }}/{{ row.id }}">{{ row.id }}</a></td>{% if section %}<td>{{ row.username }}</td>{% endif %}<td>{% for registry in row.registries %}<div>{{ registry.registry_name }} · <code>{{ registry.contact_id|default('Not created') }}</code> <span class="badge {{ registry.status == 'rejected' ? 'bg-red-lt' : 'bg-secondary-lt' }}">{{ registry.status }}</span></div>{% endfor %}</td><td><div class="btn-list flex-nowrap"><a class="btn btn-sm" href="{{ path }}/{{ row.id }}">Update</a><button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delete-{{ row.id }}">Delete</button></div>
<div class="modal fade" id="delete-{{ row.id }}" tabindex="-1" aria-label="Delete contact" aria-hidden="true"><div class="modal-dialog"><form class="modal-content" method="post" action="{{ path }}/{{ row.id }}"><div class="modal-header"><h3 class="modal-title">Delete contact</h3><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><p>Delete this contact at every linked registry? Registries can reject deletion when a contact is in use. Failed links remain available with their EPP error.</p><code>{{ row.id }}</code><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="key" value="{{ key }}"><input type="hidden" name="version" value="{{ row.version }}"><input type="hidden" name="action" value="delete"></div><div class="modal-footer"><button type="button" class="btn" data-bs-dismiss="modal">Cancel</button><button class="btn btn-danger">Delete at registries</button></div></form></div></div>
</td></tr>{% else %}<tr><td colspan="{{ section ? 4 : 3 }}" class="text-secondary">No contacts yet. Add one or sync an existing API-owned contact.</td></tr>{% endfor %}
</tbody></table></div></div>{% include 'partials/pagination.twig' %}
<div class="modal fade" id="add-contact" tabindex="-1" aria-label="Add contact" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><form class="modal-content" method="post" action="{{ path }}"><div class="modal-header"><h3 class="modal-title">Add contact</h3><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body">{% include 'partials/contact_form.twig' %}</div><div class="modal-footer"><button class="btn" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Create contact</button></div></form></div></div>
{% endblock %}
