<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="key" value="{{ key }}"><input type="hidden" name="action" value="save"><input type="hidden" name="contact_id" value="{{ contact.id }}">
{% if contact.version is defined %}<input type="hidden" name="version" value="{{ contact.version }}">{% endif %}
<div class="row g-3 mb-4">
{% if resellers and contact.version is not defined %}<div class="col-md-6"><label class="form-label" for="contact-owner">Reseller</label><select id="contact-owner" name="reseller_id" class="form-select" required>{% for reseller in resellers %}<option value="{{ reseller.id }}"{{ reseller.id == contact.reseller_id ? ' selected' : '' }}>{{ reseller.username }}</option>{% endfor %}</select></div>{% endif %}
<div class="col-md-6"><label class="form-label" for="contact-registries">Registries to create or update</label><select id="contact-registries" name="registries[]" class="form-select" multiple size="4" required>{% for registry in registry_options %}<option value="{{ registry.id }}"{{ contact.registries[registry.id] is defined ? ' selected' : '' }}>{{ registry.name }} · {{ registry.profile }}</option>{% endfor %}</select><div class="form-hint">Select one or more registries. Existing links use their own contact IDs; new links create the contact. Unselected links are kept. Access is checked for the contact's reseller.</div></div>
</div>
{% set labels = {'id':'Contact ID for new registry links', 'type':'Postal information type', 'firstname':'First name', 'lastname':'Last name', 'companyname':'Company', 'address1':'Address line 1', 'address2':'Address line 2', 'address3':'Address line 3', 'city':'City', 'state':'State / region', 'postcode':'Postal code', 'country':'Country code', 'fullphonenumber':'Phone (+CC.number)', 'email':'Email', 'authInfoPw':'Authorization code for new registry links', 'fax':'Fax (+CC.number)'} %}
<div class="row g-3">
{% for field in contact_fields %}{% if labels[field] is defined %}<div class="col-md-6"><label class="form-label" for="contact-{{ field }}">{{ labels[field] }}</label><input id="contact-{{ field }}" class="form-control" type="{{ field == 'authInfoPw' ? 'password' : 'text' }}" name="fields[{{ field }}]" value="{{ contact.data.fields[field]|default('') }}" autocomplete="{{ field == 'authInfoPw' ? 'new-password' : 'off' }}"><div class="form-hint">{{ field }}</div></div>{% endif %}{% endfor %}
</div>
<details class="mt-4"><summary class="fw-semibold mb-3">Registry-specific fields</summary><div class="row g-3">
{% for field in contact_fields %}{% if labels[field] is not defined %}<div class="col-md-6"><label class="form-label" for="contact-{{ field }}">{{ field }}</label><input id="contact-{{ field }}" class="form-control" type="{{ field == 'old_pw' ? 'password' : 'text' }}" name="fields[{{ field }}]" value="{{ contact.data.fields[field]|default('') }}" autocomplete="off"></div>{% endif %}{% endfor %}
</div></details>
<h3 class="mt-4">Additional parameters</h3><p class="text-secondary">Optional native API parameters for your registry profile. Leave unused rows empty. Fields and registry errors are handled as they are in the API.</p>
{% set extra_keys = contact.data.extra|default({})|keys %}
{% for i in 0..4 %}{% set extra_key = extra_keys[i]|default('') %}<div class="row g-2 mb-2"><div class="col-6"><input class="form-control" name="extra_key[{{ i }}]" value="{{ extra_key }}" placeholder="Parameter, e.g. nin" aria-label="Additional parameter {{ i + 1 }} name"></div><div class="col-6"><input class="form-control" name="extra_value[{{ i }}]" value="{{ extra_key ? contact.data.extra[extra_key] : '' }}" placeholder="Value" aria-label="Additional parameter {{ i + 1 }} value"></div></div>{% endfor %}
