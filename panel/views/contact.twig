{% extends 'layouts/app.twig' %}
{% block page_actions %}<a class="btn" href="{{ path }}">Back to contacts</a>{% endblock %}
{% block content %}
<div id="contact-state" data-version="{{ contact.version }}" data-pending="{{ pending ? '1' : '0' }}" data-list="{{ path }}"></div>
{% if pending %}<div class="alert alert-info">Registry operations are queued or processing. Results update automatically unless you are editing the form. <a href="{{ path }}/{{ contact.id }}">Refresh results</a></div>{% endif %}
<div class="card mb-4"><div class="card-header"><h2 class="card-title">Contact details</h2><span class="ms-auto text-secondary">{{ contact.username }}</span></div><form method="post" action="{{ path }}/{{ contact.id }}"><div class="card-body">{% include 'partials/contact_form.twig' %}</div><div class="card-footer text-end"><button class="btn btn-primary">Save and submit to selected registries</button></div></form></div>
<div class="card"><div class="card-header"><h2 class="card-title">Sync contact</h2></div><div class="card-body text-secondary">Sync replaces the editable contact details with the selected registry's contact-info response. It does not update other registries until you save. Registry contact IDs remain specific to each link.</div><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Registry</th><th>Contact ID</th><th>Latest result</th><th>Actions</th></tr></thead><tbody>
{% for registry_id, registry in contact.registries %}<tr><td>{{ registry.registry_name }}</td><td><code>{{ registry.contact_id|default('Not created') }}</code></td><td><span class="badge {{ registry.status == 'rejected' ? 'bg-red-lt' : 'bg-secondary-lt' }}">{{ registry.status }}</span>{% if registry.epp_code %}<span class="ms-1">EPP {{ registry.epp_code }}</span>{% endif %}<div class="mt-1">{{ registry.message|default('') }}</div>{% if registry.job_uuid %}<a href="{{ section ? '/admin/jobs/' : '/jobs/' }}{{ registry.job_uuid }}">Job details</a>{% endif %}</td><td>
{% if registry.contact_id %}<form method="post" action="{{ path }}/{{ contact.id }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="key" value="{{ key }}"><input type="hidden" name="version" value="{{ contact.version }}"><input type="hidden" name="registry_id" value="{{ registry_id }}"><button class="btn btn-sm btn-outline-primary" name="action" value="sync">Sync from registry</button></form>
<details class="mt-2"><summary class="small">Change authorization code</summary><form method="post" action="{{ path }}/{{ contact.id }}" class="mt-2"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="key" value="{{ key }}"><input type="hidden" name="version" value="{{ contact.version }}"><input type="hidden" name="registry_id" value="{{ registry_id }}"><input type="password" class="form-control form-control-sm mb-2" name="authInfo" required autocomplete="new-password" aria-label="New authorization code"><button class="btn btn-sm" name="action" value="authinfo">Update auth code</button></form></details>{% endif %}
{% if registry.status == 'prepared' %}<form method="post" action="{{ path }}/{{ contact.id }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="key" value="{{ key }}"><button class="btn btn-sm" name="action" value="resume">Resume submission</button></form>{% endif %}
</td></tr>{% endfor %}</tbody></table></div></div>
<script src="/contacts.js" defer></script>
{% endblock %}
