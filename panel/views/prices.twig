{% extends 'layouts/app.twig' %}
{% macro amount(price) %}
{% if price %}<span class="fw-semibold">{{ price.amount }} <span class="text-secondary">{{ price.currency }}</span></span>{% if price.scope == 'Reseller override' %}<div class="small text-primary">Your override</div>{% endif %}{% else %}<span class="text-secondary">—</span>{% endif %}
{% endmacro %}
{% block content %}
<p class="text-secondary">Total prices for each term, grouped by configured suffix. Registration includes DNSSEC at the same price. Transfer query, cancel, approve and reject are always free.</p>
<div class="row row-cards">
{% for group in price_groups %}
<div class="col-12 col-xl-6"><div class="card h-100">
<div class="card-header"><div><h2 class="card-title fs-2">{{ group.tld ? '.' ~ group.tld : 'Registry-wide restore' }}</h2><div class="text-secondary">{{ group.registry }}</div></div></div>
{% if group.terms is defined %}<div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Years</th><th>Registration</th><th>Renewal</th><th>Incoming transfer</th></tr></thead><tbody>
{% for year, prices in group.terms %}<tr><th scope="row">{{ year }}</th><td>{{ _self.amount(prices['domain.create'] ?? null) }}</td><td>{{ _self.amount(prices['domain.renew'] ?? null) }}</td><td>{{ _self.amount(prices['domain.transfer'] ?? null) }}</td></tr>{% endfor %}
</tbody></table></div>{% endif %}
{% if group.restore is defined %}<div class="card-footer d-flex justify-content-between align-items-center"><span>Restore <span class="text-secondary small">per operation</span></span><span>{{ _self.amount(group.restore) }}</span></div>{% endif %}
</div></div>
{% else %}<div class="col-12"><div class="card card-body text-secondary text-center">No prices are configured for your permitted TLDs.</div></div>{% endfor %}
</div>
<p class="text-secondary mt-3">Amounts are exact term totals. A dash means no exact price row is listed; a parent-suffix or global fallback may still apply. The longest matching suffix takes priority, then your reseller override. This is a configured price list, not a live premium-domain quote.</p>
{% endblock %}
