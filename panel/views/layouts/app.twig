<!doctype html>
<html lang="en" data-bs-theme-primary="blue">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ title }} | Namingo Reseller</title>
  <link href="/assets/css/tabler.min.css" rel="stylesheet">
  <link href="/panel.css" rel="stylesheet">
</head>
<body{% if not user %} class="border-top-wide border-primary d-flex flex-column"{% endif %}>
<div class="page">
{% if user %}
      <header class="navbar navbar-expand-md navbar-light d-print-none">
        <div class="container-xl">
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <h1 class="navbar-brand d-none-navbar-horizontal pe-0 pe-md-3 flex-fill flex-md-grow-0 justify-content-center justify-content-md-start">
            <a class="navbar-brand" href="/">
              Namingo Reseller
            </a>
          </h1>
          <div class="navbar-nav flex-row align-items-center ms-auto order-md-last gap-2">
            <div class="nav-item dropdown">
              <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Open user menu">
                <span class="avatar bg-primary-lt">{{ user.username|slice(0, 2)|upper }}</span>
              </a>
              <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                <div class="dropdown-item-text lh-sm">
                  <div>{{ user.username }}</div>
                  <div class="small text-secondary">{{ user.email }}</div>
                </div>
                <div class="dropdown-divider"></div>
                <a href="/account" class="dropdown-item">My Profile</a>
                <div class="dropdown-divider"></div>
                <form method="post" action="/logout" class="m-0"><input type="hidden" name="csrf" value="{{ csrf }}"><button type="submit" class="dropdown-item">Sign out</button></form>
              </div>
            </div>
          </div>
        </div>
      </header>
      <div class="navbar-expand-md">
        <div class="collapse navbar-collapse" id="navbar-menu">
          <div class="navbar navbar-light">
            <div class="container-xl">
              <ul class="navbar-nav">
                <li class="nav-item active">
                  <a class="nav-link" href="/">
                    <span class="nav-link-icon d-md-none d-lg-inline-block">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 4h4a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-6a1 1 0 0 1 1 -1" /><path d="M5 16h4a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-2a1 1 0 0 1 1 -1" /><path d="M15 12h4a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-6a1 1 0 0 1 1 -1" /><path d="M15 4h4a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-2a1 1 0 0 1 1 -1" /></svg>
                    </span>
                    <span class="nav-link-title">
                      Dashboard
                    </span>
                  </a>
                </li>
                <li class="nav-item dropdown">
                  <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                    <span class="nav-link-icon d-md-none d-lg-inline-block">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /><path d="M3.6 9h16.8" /><path d="M3.6 15h16.8" /><path d="M11.5 3a17 17 0 0 0 0 18" /><path d="M12.5 3a17 17 0 0 1 0 18" /></svg>
                    </span>
                    <span class="nav-link-title">
                      Domains
                    </span>
                  </a>
                  <div class="dropdown-menu">
                    <a class="dropdown-item" href="/domains">
                      Domains
                    </a>
                    <a class="dropdown-item" href="/checks">
                      Check Domain
                    </a>
                    <a class="dropdown-item" href="/transfers">
                      Transfers
                    </a>
                    {% if user.role == 0 %}
                    <div class="dropdown-divider"></div>
                    <h6 class="dropdown-header small fw-bold text-blue">Administration</h6>
                    <a class="dropdown-item" href="/admin/domains">
                      Domains
                    </a>
                    <a class="dropdown-item" href="/admin/transfers">Transfers</a>
                    {% endif %}
                  </div>
                </li>
                <li class="nav-item dropdown">
                  <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                    <span class="nav-link-icon d-md-none d-lg-inline-block">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 7a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" /><path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /><path d="M21 21v-2a4 4 0 0 0 -3 -3.85" /></svg>
                    </span>
                    <span class="nav-link-title">Contacts</span>
                  </a>
                  <div class="dropdown-menu">
                    <a class="dropdown-item" href="/contacts">
                      Contacts
                    </a>
                    {% if user.role == 0 %}
                    <div class="dropdown-divider"></div>
                    <h6 class="dropdown-header small fw-bold text-blue">Administration</h6>
                    <a class="dropdown-item" href="/admin/contacts">
                      Contacts
                    </a>
                    {% endif %}
                  </div>
                </li>
                <li class="nav-item dropdown">
                  <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                    <span class="nav-link-icon d-md-none d-lg-inline-block">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 21v-16a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v16l-3 -2l-2 2l-2 -2l-2 2l-2 -2l-3 2m4 -14h6m-6 4h6m-2 4h2" /></svg>
                    </span>
                    <span class="nav-link-title">
                      Billing
                    </span>
                  </a>
                  <div class="dropdown-menu">
                    <a class="dropdown-item" href="/wallet">
                      Wallet
                    </a>
                    <a class="dropdown-item" href="/prices">
                      Prices
                    </a>
                    {% if user.role == 0 %}
                    <div class="dropdown-divider"></div>
                    <h6 class="dropdown-header small fw-bold text-blue">Administration</h6>
                    <a class="dropdown-item" href="/admin/deposits">
                      Deposits
                    </a>
                    <a class="dropdown-item" href="/admin/prices">
                      Prices
                    </a>
                    {% endif %}
                  </div>
                </li>
                <li class="nav-item dropdown">
                  <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                    <span class="nav-link-icon d-md-none d-lg-inline-block"><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z"></path> <path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path></svg>
                    </span>
                    <span class="nav-link-title">
                      System
                    </span>
                  </a>
                  <div class="dropdown-menu">
                    <a class="dropdown-item" href="/jobs">
                      Jobs
                    </a>
                    {% if user.role == 0 %}
                    <div class="dropdown-divider"></div>
                    <h6 class="dropdown-header small fw-bold text-blue">Administration</h6>
                    <a class="dropdown-item" href="/admin/resellers">
                      Resellers
                    </a>
                    <a class="dropdown-item" href="/admin/registries">
                      Registries
                    </a>
                    <a class="dropdown-item" href="/admin/jobs">
                      Jobs
                    </a>
                    <a class="dropdown-item" href="/admin/ownership">
                      Ownership
                    </a>
                    {% endif %}
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
{% endif %}
<main class="page-wrapper">
  <div class="page-body"><div class="{{ user ? 'container-xl' : 'container-tight py-5' }}">
    {% if flash %}<div class="alert alert-success" role="status">{{ flash }}</div>{% endif %}
    {% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
    {% if user %}<div class="page-header mb-4"><div class="row align-items-center g-2"><div class="col"><div class="page-pretitle">{{ section ? 'Administration' : 'Reseller workspace' }}</div><h1 class="page-title">{{ title }}</h1></div><div class="col-auto ms-auto d-print-none">{% block page_actions %}{% endblock %}</div></div></div>{% endif %}
    {% block content %}{% endblock %}
  </div></div>
  <footer class="footer footer-transparent"><div class="container-xl text-center text-secondary">Namingo Reseller</div></footer>
</main>
</div>
{% include 'partials/js.twig' %}
</body>
</html>
