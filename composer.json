{
    "name": "namingo/reseller",
    "description": "Compact Swoole JSON API and ledger facade for Namingo EPP Client",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-simplexml": "*",
        "ext-sodium": "*",
        "ext-swoole": "*",
        "ext-xmlwriter": "*",
        "guzzlehttp/guzzle": "^7.9",
        "pinga/tembo": "1.1.23",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}