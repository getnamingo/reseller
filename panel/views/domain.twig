{% extends 'layouts/app.twig' %}
{% macro hidden(csrf, key, action) %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="key" value="{{ key }}"><input type="hidden" name="action" value="{{ action }}">{% endmacro %}
{% import _self as form %}
{% block page_actions %}<a class="btn" href="{{ path }}">Back to domains</a><form class="d-inline" method="post" action="{{ url }}">{{ form.hidden(csrf, key, 'sync') }}<button class="btn btn-primary">Sync domain</button></form>{% endblock %}
{% block content %}
<div class="card mb-4"><div class="card-header"><h2 class="card-title">Domain details</h2></div><div class="card-body"><div class="datagrid">
{% for label, value in {'Domain':domain.object_name, 'Registry':domain.registry, 'Reseller':domain.username, 'State':domain.domain_state, 'Created':info.crDate|default('—'), 'Expires':info.exDate|default('—'), 'Updated':info.upDate|default('—'), 'Transferred':info.trDate|default('—'), 'Registry object ID':info.roid|default('—'), 'Registrant':info.registrant|default('—')} %}<div class="datagrid-item"><div class="datagrid-title">{{ label }}</div><div class="datagrid-content">{{ value }}</div></div>{% endfor %}
<div class="datagrid-item"><div class="datagrid-title">Registry statuses</div><div class="datagrid-content">{% for status in info.status|default([]) %}<span class="badge bg-secondary-lt me-1">{{ status }}</span>{% else %}—{% endfor %}</div></div>
</div>{% if info is empty %}<div class="text-secondary mt-3">Domain information is not available yet. Use Sync domain to retrieve it.</div>{% endif %}
</div></div>
<div class="row g-4">
<div class="col-lg-6"><div class="card h-100"><div class="card-header"><h2 class="card-title">Contacts</h2></div><div class="card-body">
<div class="datagrid mb-3">{% for role in ['admin','tech','billing'] %}<div class="datagrid-item"><div class="datagrid-title">{{ role|capitalize }}</div><div class="datagrid-content">{{ contact_ids[role]|default('—') }}</div></div>{% endfor %}</div>
<form method="post" action="{{ url }}">{{ form.hidden(csrf, key, 'contact') }}
<label class="form-label">Contact role<select class="form-select" name="contacttype"><option value="registrant">Registrant (owner)</option><option value="admin">Administrative</option><option value="tech">Technical</option><option value="billing">Billing</option></select></label>
<label class="form-label">Current contact ID<input class="form-control" name="old_contactid" placeholder="Required when replacing a non-registrant contact"></label>
<label class="form-label">New contact ID<input class="form-control" name="new_contactid"></label><div class="form-hint">For registrant changes, enter the new registrant ID. Other roles use the current and new IDs; leave one blank to add or remove a role when supported by the registry.</div>
{% include 'partials/domain_native.twig' %}<button class="btn btn-primary mt-3">Update contact</button></form></div></div></div>
<div class="col-lg-6"><div class="card h-100"><div class="card-header"><h2 class="card-title">Nameservers</h2></div><div class="card-body">
{% if hosts|length > 5 %}<div class="alert alert-warning">This domain has more than five nameservers. Use the API to preserve the complete set when editing it.</div>{% else %}
<form method="post" action="{{ url }}">{{ form.hidden(csrf, key, 'nameservers') }}{% include 'partials/domain_nameservers.twig' %}
<label class="form-check mt-2"><input class="form-check-input" type="checkbox" name="replace_nameservers" value="yes" required><span class="form-check-label">Replace the complete nameserver set with these values.</span></label>
{% include 'partials/domain_native.twig' %}<button class="btn btn-primary mt-3">Update nameservers</button></form>{% endif %}
</div></div></div>
<div class="col-lg-6"><div class="card h-100"><div class="card-header"><h2 class="card-title">DNSSEC</h2></div><div class="card-body">
{% if info.dsData|default([]) or info.keyData|default([]) %}<details class="mb-3"><summary>Current DNSSEC records</summary><pre class="mt-2">{{ {dsData:info.dsData|default([]),keyData:info.keyData|default([])}|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details>{% else %}<p class="text-secondary">No DNSSEC records were returned by the last sync.</p>{% endif %}
<form method="post" action="{{ url }}">{{ form.hidden(csrf, key, 'dnssec') }}<label class="form-label">Operation<select class="form-select" name="dnssec_action"><option value="add">Add record 1</option><option value="rem">Remove record 1</option><option value="addrem">Replace record 1 with record 2</option></select></label>
{% include 'partials/domain_dnssec.twig' %}{% include 'partials/domain_native.twig' %}<button class="btn btn-primary mt-3">Update DNSSEC</button></form>
</div></div></div>
<div class="col-lg-6"><div class="card h-100"><div class="card-header"><h2 class="card-title">Authorization code and statuses</h2></div><div class="card-body">
<form method="post" action="{{ url }}">{{ form.hidden(csrf, key, 'authinfo') }}<label class="form-label">New authorization code<input class="form-control" type="password" name="authInfo" autocomplete="new-password" required></label>{% include 'partials/domain_native.twig' %}<button class="btn btn-primary mt-3">Change authorization code</button></form>
<hr><form method="post" action="{{ url }}">{{ form.hidden(csrf, key, 'status') }}<div class="row g-2"><div class="col"><label class="form-label">Action<select class="form-select" name="status_action"><option value="add">Add</option><option value="rem">Remove</option></select></label></div><div class="col"><label class="form-label">Status<input class="form-control" name="status" placeholder="clientTransferProhibited" required></label></div></div>{% include 'partials/domain_native.twig' %}<button class="btn mt-3">Update status</button></form>
</div></div></div>
<div class="col-lg-6" id="renew"><div class="card h-100"><div class="card-header"><h2 class="card-title">Renew domain</h2></div><div class="card-body"><p>Renew {{ domain.object_name }} at the configured renewal price.</p><form method="post" action="{{ url }}">{{ form.hidden(csrf, key, 'renew') }}<label class="form-label">Years<select class="form-select" name="years">{% for i in 1..10 %}<option>{{ i }}</option>{% endfor %}</select></label>{% include 'partials/domain_native.twig' %}<button class="btn btn-primary mt-3">Renew at configured price</button></form></div></div></div>
<div class="col-lg-6" id="delete"><div class="card h-100 border-danger"><div class="card-header"><h2 class="card-title">Delete domain</h2></div><div class="card-body"><p>Request deletion of {{ domain.object_name }} at the registry. Registry restrictions and redemption rules apply.</p><form method="post" action="{{ url }}">{{ form.hidden(csrf, key, 'delete') }}<label class="form-check"><input class="form-check-input" type="checkbox" name="confirm" value="yes" required><span class="form-check-label">I confirm deletion of this domain.</span></label>{% include 'partials/domain_native.twig' %}<button class="btn btn-danger mt-3">Delete domain</button></form></div></div></div>
</div>
<div class="card mt-4"><div class="card-header"><h2 class="card-title">Transfer and restore</h2></div><div class="card-body"><form method="post" action="{{ url }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="key" value="{{ key }}"><label class="form-label">API operation<select class="form-select" name="action"><option value="transfer">Transfer query / cancel / approve / reject</option><option value="restore">Restore at configured price</option><option value="restore_report">Submit restore report</option></select></label><label class="form-label">Native API parameters (JSON object)<textarea class="form-control font-monospace" name="native" rows="4" placeholder='{"op":"query"}'></textarea></label><div class="form-hint">Use the native API fields for the selected registry. A restore report requires the API's report fields and statements. Transfer requests use the API directly; this card manages an already owned domain.</div><button class="btn mt-3">Submit operation</button></form></div></div>
{% include 'partials/domain_operations.twig' %}
{% endblock %}