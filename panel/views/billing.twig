{% extends 'layouts/app.twig' %}
{% block content %}
<div class="card card-body"><h2 class="card-title">Company billing details</h2><p class="text-secondary">Use your company's registered details. These are saved on newly issued invoices. An administrator sets the VAT treatment. Changes to legal identity, country or VAT number require a new tax review before the next invoice.</p><form method="post"><input type="hidden" name="csrf" value="{{ csrf }}">
<div class="row g-3">{% for field,label in {'company':'Registered company name','company_number':'Company registration number','vat_number':'VAT identification number (if registered)','billing_email':'Invoice email','billing_city':'City','billing_postcode':'Postal code','country_code':'Country'} %}<div class="col-md-6"><label class="form-label">{{ label }}{% if field == 'country_code' %}{% include 'partials/country_select.twig' with {countries: countries, country_name: field, country_value: account.country_code, country_required: true} only %}{% else %}<input class="form-control" name="{{ field }}" value="{{ attribute(account,field) }}" maxlength="{{ field in ['company','billing_email'] ? 254 : (field == 'country_code' ? 2 : (field == 'billing_city' ? 128 : (field == 'company_number' ? 64 : 32))) }}" type="{{ field == 'billing_email' ? 'email' : 'text' }}"{% if field != 'vat_number' %} required{% endif %}>{% endif %}</label></div>{% endfor %}</div>
<label class="form-label mt-3">Registered street address<textarea class="form-control" name="address" maxlength="2000" rows="3" required>{{ account.address }}</textarea></label>
<p class="text-secondary">VAT treatment: {{ account.invoice_tax_mode }} · VAT rate: {{ account.invoice_vat_rate }}%. {{ account.invoice_tax_note }}</p><button class="btn btn-primary">Save billing details</button></form></div>
{% endblock %}
