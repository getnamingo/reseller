<div class="card"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Registry</th><th>Profile</th><th>State</th><th>Manage</th></tr></thead><tbody>
{% for registry in rows %}<tr><td><a class="fw-semibold" href="/admin/registries/{{ registry.id }}">{{ registry.name }}</a><div class="uuid text-secondary small">{{ registry.id }}</div></td><td>{{ registry.profile }}</td><td><span class="badge {{ registry.enabled ? 'bg-green-lt' : 'bg-secondary-lt' }}">{{ registry.enabled ? 'Enabled' : 'Disabled' }}</span></td><td><div class="btn-list flex-nowrap"><a class="btn btn-sm btn-outline-primary" href="/admin/registries/{{ registry.id }}">Edit registry</a><a class="btn btn-sm btn-outline-primary" href="/admin/registries/{{ registry.id }}/tlds">TLDs</a><a class="btn btn-sm btn-outline-primary" href="/admin/registries/{{ registry.id }}/permissions">TLD permissions</a></div></td></tr>
{% else %}<tr><td colspan="4" class="text-secondary text-center py-4">No registries configured.</td></tr>{% endfor %}
</tbody></table></div></div>
